      },
      {
        "id": "empty",
        "input": [],
        "expected": [],
        "category": "regression"
      },
      {
        "id": "case-preserved",
        "input": [
          " A",
          "a ",
          " a"
        ],
        "expected": [
          "A",
          "a"
        ],
        "category": "functional"
      }
    ]
  }
}
