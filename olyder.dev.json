{
  "schema_version": 2,
  "goal": "Verify Olyder's deterministic verdicts, protected acceptance harness, and agent accounting.",
  "requirements": [
    {
      "id": "verdict-and-integrity",
      "text": "Mandatory checks and protected acceptance inputs govern the final verdict across the supported verification entry points.",
      "acceptance_check_ids": ["verification-regressions"]
    },
    {
      "id": "agent-accounting",
      "text": "Observed agent usage remains distinct from estimates, and incomplete usage cannot be priced as complete.",
      "acceptance_check_ids": ["agent-regressions"]
    }
  ],
  "protected_paths": ["tests", "pyproject.toml"],
  "checks": [
    {
      "id": "verification-regressions",
      "type": "command",
      "argv": ["python", "-m", "pytest", "-q", "tests/test_sdk.py", "tests/test_verified_harness.py", "tests/test_v05_verdict.py", "tests/test_mcp_hardening.py", "tests/test_release_metadata.py"],
      "timeout": 120
    },
    {
      "id": "agent-regressions",
      "type": "command",
      "argv": ["python", "-m", "pytest", "-q", "tests/test_universal_adapters.py", "tests/test_v04.py", "tests/test_universal_review.py", "tests/test_v05_ledger.py"],
      "timeout": 120
    }
  ],
  "limits": {
    "max_seconds": 240
  }
}
